# Database Configuration
# For local development, use localhost
# For dev/prod, use your actual database server
DATABASE_URL=jdbc:postgresql://dev-db.example.com:5432/course_platform_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password_here

# JWT Configuration
# Generate a strong secret key for production
# You can use: openssl rand -base64 32
JWT_SECRET=jwt_secret_key_min_32_chars_recommended
JWT_EXPIRATION_MS=604800000

# Logging Configuration
# Valid levels: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_WEB=DEBUG
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_HIBERNATE_SQL=DEBUG
LOG_LEVEL_HIBERNATE_BINDER=TRACE

# Server Configuration
SERVER_PORT=8080

# Spring Profiles
# Options: local, dev, prod
SPRING_PROFILES_ACTIVE=local

# Application Configuration
# Set to true for development, false for production
SHOW_SQL=true
